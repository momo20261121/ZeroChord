# Copy to .env, edit locally, then: set -a; . ./.env; set +a
# .env is ignored by Git. Do not put credentials into this example.
ZEROCHORD_SSH_HOST=cardputer
# Optional; otherwise SSH uses its normal user configuration.
ZEROCHORD_SSH_CONFIG=
# Relative to the SSH user's home, or an absolute path on the device.
ZEROCHORD_REMOTE_DIR=ZeroChord
# Supply a public package contact before building a .deb.
ZEROCHORD_MAINTAINER='ZeroChord contributors <maintainers@example.invalid>'
# Optional public source/project URL; omitted from packages when empty.
ZEROCHORD_HOMEPAGE=
# Repository-local development identity; no personal email is required.
GIT_AUTHOR_NAME='ZeroChord contributors'
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME='ZeroChord contributors'
GIT_COMMITTER_EMAIL=
